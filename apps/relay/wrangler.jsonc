{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oort-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Custom domain. Attached on the first deploy once the oortcloud.dev zone is on this account.
  "routes": [{ "pattern": "relay.oortcloud.dev", "custom_domain": true }],
  "workers_dev": false,
  // Invocation logs are off: they would record each request's URL, headers and the `cf` object
  // (IP-derived location). The only log is the Worker's own line per request, status and duration
  // (src/index.ts), at a 10% head sample. No body, key or IP is ever logged.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 0.1 },
  },
  // Hourly: delete `oort login` requests (cli_sessions) older than an hour (src/prune.ts).
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oort-accounts",
      // Placeholder. Replace with the id printed by `wrangler d1 create oort-accounts`,
      // and use the same id in apps/site/wrangler.jsonc (binding ACCOUNTS_DB).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // RATE_LIMITER: 60 requests per 10 s, counted per key (the key hash) and again per account
  // (`account:<id>`, across all its keys). AUTH_LIMITER: 20 failed sign-ins (unknown or revoked
  // keys) per minute per IP. The simple limiter counts per Cloudflare location, so these are speed
  // bumps; the monthly caps in D1 are the budget. namespace_id is any integer unique to the account.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "4101",
      "simple": { "limit": 60, "period": 10 },
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "4102",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  // Secrets, set with `wrangler secret put <NAME>` (see README). Never put values here.
  //   VOYAGE_API_KEY
  //   TYPESAFE_API_KEY
  //   ANTHROPIC_API_KEY
}
