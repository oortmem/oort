{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oort-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Custom domain. Attached on the first deploy once the oortcloud.dev zone is on this account.
  "routes": [{ "pattern": "relay.oortcloud.dev", "custom_domain": true }],
  "workers_dev": false,
  // Status and timings only. The code never calls console, so these invocation logs are the
  // only logs: method, URL path, status, duration. No body is ever logged.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 0.1 },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oort-accounts",
      // Placeholder. Replace with the id printed by `wrangler d1 create oort-accounts`,
      // and use the same id in apps/site/wrangler.jsonc (binding ACCOUNTS_DB).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // 60 requests per 10 s per key (keyed by the key hash). namespace_id is any integer unique
  // to the Cloudflare account.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "4101",
      "simple": { "limit": 60, "period": 10 },
    },
  ],
  // Secrets, set with `wrangler secret put <NAME>` (see README). Never put values here.
  //   VOYAGE_API_KEY
  //   TYPESAFE_API_KEY
  //   ANTHROPIC_API_KEY
}
