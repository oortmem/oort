{
  "name": "oortmem",
  "version": "0.6.0",
  "description": "Oort: memory for AI coding agents. The oort command line, MCP server and agent connectors.",
  "keywords": [
    "oort",
    "agent-memory",
    "ai-agents",
    "llm-memory",
    "cli",
    "mcp",
    "claude-code",
    "codex",
    "cursor"
  ],
  "homepage": "https://oortcloud.dev",
  "bugs": {
    "url": "https://github.com/oortmem/oort/issues",
    "email": "hello@oortcloud.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oortmem/oort.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "author": "Oort <hello@oortcloud.dev>",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "sideEffects": [
    "./dist/main.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/sdk/adapters/ai-sdk.d.ts",
      "default": "./dist/sdk/adapters/ai-sdk.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "oort": "dist/main.js",
    "oortmem": "dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/main.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@oortmem/claude-code": "workspace:*",
    "@oortmem/core": "workspace:*",
    "@oortmem/decide-jev": "workspace:*",
    "@oortmem/embed-voyage": "workspace:*",
    "@oortmem/mcp": "workspace:*",
    "@oortmem/rerank-voyage": "workspace:*",
    "@oortmem/store-sqlite": "workspace:*",
    "@oortmem/writer": "workspace:*",
    "commander": "15.0.0",
    "jsonc-parser": "3.3.1",
    "picocolors": "1.1.1",
    "smol-toml": "1.9.1",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@oortmem/local-models": "workspace:^",
    "ai": "^7"
  },
  "peerDependenciesMeta": {
    "@oortmem/local-models": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@oortmem/local-models": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "better-sqlite3": "13.0.3",
    "execa": "10.2.1",
    "vitest": "^5.0.5"
  }
}
