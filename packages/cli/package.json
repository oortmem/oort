{
  "name": "oort",
  "version": "0.0.0",
  "description": "Oort: tiered agent memory for coding agents (command line).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "oort": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/main.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@oortmem/claude-code": "workspace:*",
    "@oortmem/core": "workspace:*",
    "@oortmem/decide-jev": "workspace:*",
    "@oortmem/embed-voyage": "workspace:*",
    "@oortmem/rerank-voyage": "workspace:*",
    "@oortmem/store-sqlite": "workspace:*",
    "@oortmem/writer": "workspace:*",
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "execa": "10.2.1",
    "vitest": "^5.0.5"
  }
}
