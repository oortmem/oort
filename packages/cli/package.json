{
  "name": "oortmem",
  "version": "0.0.0",
  "description": "Oort: tiered agent memory for coding agents (command line).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "oort": "dist/main.js",
    "oortmem": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/main.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@oortmem/claude-code": "workspace:*",
    "@oortmem/core": "workspace:*",
    "@oortmem/decide-jev": "workspace:*",
    "@oortmem/embed-voyage": "workspace:*",
    "@oortmem/rerank-voyage": "workspace:*",
    "@oortmem/store-sqlite": "workspace:*",
    "@oortmem/writer": "workspace:*",
    "commander": "15.0.0",
    "jsonc-parser": "3.3.1",
    "picocolors": "1.1.1",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/better-sqlite3": "9.6.0",
    "better-sqlite3": "13.0.3",
    "execa": "10.2.1",
    "vitest": "^5.0.5"
  }
}
