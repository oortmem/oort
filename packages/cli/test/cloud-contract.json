{
  "$comment": "The contract between the open-source CLI (oortmem/oort) and the Oort Cloud API (oortmem/oortcloud, apps/cloud). The CLI tests itself against a fake that follows this file; the API repo keeps an identical copy and tests the real Worker against it. Change both together.",
  "baseUrl": "https://api.oortcloud.dev",
  "auth": "Authorization: Bearer oort_sk_…",
  "routes": [
    {
      "method": "GET",
      "path": "/v1/whoami",
      "response": ["account", "plan", "via"]
    },
    {
      "method": "POST",
      "path": "/v1/recall",
      "request": {
        "text": "string",
        "project": "string?",
        "k": "number?",
        "mode": "string?",
        "asOf": "string?",
        "knownAt": "string?",
        "include": "string[]?"
      },
      "response": ["memories", "timings", "temporal", "read?", "degraded?", "degradedNodes?"]
    },
    {
      "method": "POST",
      "path": "/v1/observe",
      "request": {
        "project": "string?",
        "turnRef": "string?",
        "observation": {
          "user": "string",
          "assistant": "string",
          "at": "string?",
          "session": "string?",
          "tools": "string[]?"
        }
      },
      "response": ["outcome", "memories", "counts", "duplicate?"]
    },
    {
      "method": "GET",
      "path": "/v1/memories",
      "billing": "any",
      "query": ["project", "tier", "type", "q", "cursor", "limit", "pinned"],
      "response": ["memories", "next?"]
    },
    {
      "method": "GET",
      "path": "/v1/map",
      "billing": "any",
      "response": ["version", "fields", "projects", "rows"]
    },
    {
      "method": "POST",
      "path": "/v1/previews",
      "billing": "any",
      "request": {
        "ids": "string[]"
      },
      "response": ["previews"]
    },
    {
      "method": "GET",
      "path": "/v1/memories/:id",
      "response": "memory",
      "billing": "any"
    },
    {
      "method": "DELETE",
      "path": "/v1/memories/:id",
      "status": 204,
      "billing": "any"
    },
    {
      "method": "POST",
      "path": "/v1/memories/:id/pin",
      "status": 204
    },
    {
      "method": "POST",
      "path": "/v1/memories/:id/unpin",
      "status": 204
    },
    {
      "method": "GET",
      "path": "/v1/stats",
      "billing": "any",
      "response": ["tiers", "memories", "databaseBytes", "lastConsolidatedAt"]
    },
    {
      "method": "GET",
      "path": "/v1/export",
      "contentType": "application/x-ndjson",
      "billing": "any"
    },
    {
      "method": "POST",
      "path": "/v1/import",
      "query": ["from"],
      "body": "export format v1 JSON Lines, manifest first",
      "response": ["imported", "skipped", "reembedded", "next?"]
    }
  ],
  "memory": {
    "fields": [
      "id",
      "scope",
      "type",
      "text",
      "stub",
      "entities",
      "salience",
      "activation",
      "pinned",
      "tier",
      "accessLog",
      "validFrom",
      "validTo",
      "expiredAt",
      "endReason",
      "lastConfirmedAt",
      "supersedes",
      "supersededBy",
      "source",
      "createdAt",
      "updatedAt"
    ],
    "never": ["embedding"]
  },
  "error": {
    "shape": {
      "error": {
        "code": "string",
        "message": "string"
      }
    }
  },
  "errors": {
    "400": "bad-request",
    "401": "unauthorized",
    "402": "payment-required",
    "403:cloud_not_enabled": "not-enabled",
    "403:hive_not_enabled": "hive-not-enabled",
    "403": "refused",
    "404": "not-found",
    "409:ambiguous": "ambiguous-prefix",
    "413": "too-large",
    "429": "rate-limit",
    "503": "busy"
  },
  "limits": {
    "observeBytes": 131072,
    "recallBytes": 16384,
    "recallTextBytes": 2048,
    "recallK": 50,
    "importBytes": 10485760,
    "importLinesPerCall": 1000,
    "listLimit": 100,
    "previewIds": 100,
    "previewChars": 80
  },
  "hive": {
    "$comment": "Constellations (CON-63): an invite-only beta behind accounts.hive_beta. Outside it every route here answers 403 hive_not_enabled. :c is a Constellation id or its name (URL-encoded); one the caller is not a member of answers 404, exactly like one that does not exist. Recall reads the caller's Constellations (at most 4) on its own; a hive memory carries origin.level 'hive' and origin.node 'Constellation <name>', and a dropped hive leg is listed in degradedNodes as { node, reason } with 'hive-unavailable' in degraded.",
    "constellation": ["id", "name", "role", "owner", "members", "policy", "joinedAt"],
    "routes": [
      {
        "method": "GET",
        "path": "/v1/constellations",
        "response": ["constellations"]
      },
      {
        "method": "POST",
        "path": "/v1/constellations",
        "request": {
          "name": "string"
        },
        "status": 201,
        "response": ["id", "name", "role", "owner", "members", "policy", "joinedAt"]
      },
      {
        "method": "GET",
        "path": "/v1/constellations/:c",
        "response": [
          "id",
          "name",
          "role",
          "owner",
          "members",
          "policy",
          "joinedAt",
          "memories",
          "roster"
        ]
      },
      {
        "method": "POST",
        "path": "/v1/constellations/:c/share",
        "request": {
          "memoryId": "string",
          "text": "string?",
          "confirm": "boolean?",
          "privateProjects": "string[]?"
        },
        "response": ["confirmed", "memoryId", "constellation", "text", "findings", "id?"]
      },
      {
        "method": "GET",
        "path": "/v1/constellations/:c/memories",
        "query": ["cursor", "limit"],
        "response": ["memories", "next?"]
      },
      {
        "method": "GET",
        "path": "/v1/constellations/:c/memories/:id",
        "response": "memory"
      },
      {
        "method": "GET",
        "path": "/v1/constellations/:c/map",
        "response": ["version", "fields", "projects", "rows", "mine", "contributors"]
      },
      {
        "method": "DELETE",
        "path": "/v1/constellations/:c/memories/:id",
        "response": ["outcome"]
      },
      {
        "method": "GET",
        "path": "/v1/memories/:id/shares",
        "response": ["shares"]
      },
      {
        "method": "DELETE",
        "path": "/v1/memories/:id?everywhere=1",
        "response": ["withdrawn", "requested", "unreachable"]
      }
    ],
    "limits": {
      "shareTextChars": 4096,
      "fanout": 4,
      "legTimeoutMs": 150
    }
  }
}
