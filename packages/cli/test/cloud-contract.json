{
  "$comment": "The contract between the open-source CLI (oortmem/oort) and the Oort Cloud API (oortmem/oortcloud, apps/cloud). The CLI tests itself against a fake that follows this file; the API repo keeps an identical copy and tests the real Worker against it. Change both together.",
  "baseUrl": "https://api.oortcloud.dev",
  "auth": "Authorization: Bearer oort_sk_…",
  "routes": [
    { "method": "GET", "path": "/v1/whoami", "response": ["account", "plan", "via"] },
    {
      "method": "POST",
      "path": "/v1/recall",
      "request": { "text": "string", "project": "string?", "k": "number?", "asOf": "string?" },
      "response": ["memories", "timings"]
    },
    {
      "method": "POST",
      "path": "/v1/observe",
      "request": {
        "project": "string?",
        "observation": {
          "user": "string",
          "assistant": "string",
          "at": "string?",
          "session": "string?",
          "tools": "string[]?"
        }
      },
      "response": ["outcome", "memories", "counts"]
    },
    {
      "method": "GET",
      "path": "/v1/memories",
      "query": ["project", "tier", "type", "q", "cursor", "limit"],
      "response": ["memories", "next?"]
    },
    { "method": "GET", "path": "/v1/memories/:id", "response": "memory" },
    { "method": "DELETE", "path": "/v1/memories/:id", "status": 204 },
    { "method": "POST", "path": "/v1/memories/:id/pin", "status": 204 },
    { "method": "POST", "path": "/v1/memories/:id/unpin", "status": 204 },
    {
      "method": "GET",
      "path": "/v1/stats",
      "response": ["tiers", "memories", "databaseBytes", "lastConsolidatedAt"]
    },
    { "method": "GET", "path": "/v1/export", "contentType": "application/x-ndjson" },
    {
      "method": "POST",
      "path": "/v1/import",
      "query": ["from"],
      "body": "export format v1 JSON Lines, manifest first",
      "response": ["imported", "skipped", "reembedded", "next?"]
    }
  ],
  "memory": {
    "fields": [
      "id",
      "scope",
      "type",
      "text",
      "stub",
      "entities",
      "salience",
      "pinned",
      "tier",
      "accessLog",
      "validFrom",
      "validTo",
      "expiredAt",
      "endReason",
      "lastConfirmedAt",
      "supersedes",
      "supersededBy",
      "source",
      "createdAt",
      "updatedAt"
    ],
    "never": ["embedding"]
  },
  "error": { "shape": { "error": { "code": "string", "message": "string" } } },
  "errors": {
    "400": "bad-request",
    "401": "unauthorized",
    "402": "payment-required",
    "403:cloud_not_enabled": "not-enabled",
    "403": "unauthorized",
    "404": "not-found",
    "413": "too-large",
    "429": "rate-limit",
    "503": "busy"
  },
  "limits": {
    "observeBytes": 131072,
    "recallBytes": 16384,
    "recallTextBytes": 2048,
    "recallK": 50,
    "importBytes": 10485760,
    "importLinesPerCall": 1000,
    "listLimit": 100
  }
}
