{
  "name": "@oortmem/store-sqlite",
  "version": "0.6.0",
  "description": "Oort store on SQLite: FTS5 keyword search, sqlite-vec vectors and zstd cold blobs.",
  "keywords": [
    "oort",
    "agent-memory",
    "ai-agents",
    "llm-memory",
    "sqlite",
    "fts5",
    "sqlite-vec",
    "vector"
  ],
  "homepage": "https://oortcloud.dev",
  "bugs": {
    "url": "https://github.com/oortmem/oort/issues",
    "email": "hello@oortcloud.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oortmem/oort.git",
    "directory": "packages/store-sqlite"
  },
  "license": "Apache-2.0",
  "author": "Oort <hello@oortcloud.dev>",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@oortmem/core": "workspace:*",
    "better-sqlite3": "13.0.3",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "vitest": "^5.0.5"
  }
}
