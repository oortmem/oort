{
  "name": "@oortmem/core",
  "version": "0.3.0",
  "description": "Oort core: the tiered hot, warm and cold memory engine for AI agents (types, scoring, recall, consolidation).",
  "keywords": [
    "oort",
    "agent-memory",
    "ai-agents",
    "llm-memory",
    "memory",
    "engine",
    "tiered",
    "recall"
  ],
  "homepage": "https://oortcloud.dev",
  "bugs": {
    "url": "https://github.com/oortmem/oort/issues",
    "email": "hello@oortcloud.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oortmem/oort.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Oort <hello@oortcloud.dev>",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store-conformance": {
      "types": "./dist/store-conformance.d.ts",
      "default": "./dist/store-conformance.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "chrono-node": "2.10.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
