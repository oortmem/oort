{
  "name": "oort-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:public": "node scripts/check-public.mjs",
    "check:copies": "node scripts/check-voyage-http.mjs",
    "docs:reference": "node scripts/sdk-reference.mjs",
    "docs:examples": "node scripts/sdk-examples.mjs",
    "verify": "pnpm check:public && pnpm check:copies && pnpm format:check && pnpm lint && pnpm build && pnpm docs:reference --check && pnpm typecheck && pnpm test",
    "bench": "pnpm --filter @oortmem/bench run bench",
    "bench:serve": "pnpm --filter @oortmem/bench run bench:serve",
    "eval": "pnpm --filter @oortmem/bench run eval --",
    "bundle:mcpb": "node distribution/claude-desktop/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
