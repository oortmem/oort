      {
        "call": "endUsers.erase",
        "args": {
          "user": "u1"
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "end-users-unsupported"
          }
        }
      },
      {
        "call": "endUsers.export",
        "args": {
          "user": "u1"
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "end-users-unsupported"
          }
        }
      },
      {
        "call": "recall",
        "args": {
