          "result": {
            "memories": {
              "$some": {
                "id": "dddddddd-0000-4000-8000-000000000001"
              }
            }
          }
        }
      },
      {
        "call": "recall",
        "on": "cursor",
        "args": {
          "query": "blue deploy lane"
        },
        "expect": {
          "result": {
            "memories": {
              "$none": {
                "id": "dddddddd-0000-4000-8000-000000000001"
              }
            }
          }
        }
      },
      {
        "call": "recall",
        "args": {
