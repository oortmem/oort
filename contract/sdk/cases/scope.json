  {
    "id": "scope.cloud-user-needs-a-server-key",
    "description": "Per-user memory in Oort Cloud needs a server key: without the end-users capability in whoami, nothing is sent for an end user (CON-132). The account's endUsers routes ask no whoami first (they stay open while Pro has lapsed or the account is blocked), and Oort Cloud refuses a key without the capability itself (403).",
    "transports": ["cloud"],
    "options": {
      "org": "acme"
    },
    "steps": [
      {
        "call": "scoped",
        "args": {
          "user": "u1"
        },
        "as": "u1"
      },
      {
        "call": "remember",
        "on": "u1",
        "args": {
          "facts": ["The garden of u1 is in Kyoto."]
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "end-users-unsupported",
            "retryable": false
          }
        }
      },
      {
        "call": "recall",
        "on": "u1",
        "args": {
          "query": "garden Kyoto"
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "end-users-unsupported"
          }
        }
      },
      {
        "call": "endUsers.count",
        "expect": {
          "error": {
            "code": "refused",
            "reason": "end-users-not-allowed",
            "status": 403
          }
        }
      },
      {
        "call": "endUsers.export",
        "args": {
          "user": "u1"
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "end-users-not-allowed",
            "status": 403
          }
        }
      },
      {
        "call": "recall",
        "args": {
          "query": "garden Kyoto"
        },
        "expect": {
          "result": {
            "memories": {
              "$none": {
                "text": {
                  "$regex": "Kyoto"
                }
              }
            }
          }
        }
      }
    ]
  },
