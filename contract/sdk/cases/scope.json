  {
    "id": "scope.a-dropped-user-id-never-falls-back",
    "description": "A user key that is present must hold an id; only a missing key acts as the person.",
    "transports": ["local"],
    "options": {
      "org": "acme"
    },
    "steps": [
      {
        "call": "scoped",
        "args": {
          "user": null,
          "agent": "bot"
        },
        "expect": {
          "error": {
            "code": "usage",
            "reason": "user-missing"
          }
        }
      },
      {
        "call": "scoped",
        "args": {
          "user": "",
          "agent": "bot"
        },
        "expect": {
          "error": {
            "code": "usage",
            "reason": "user-missing"
          }
        }
      },
      {
        "call": "scoped",
        "args": {
          "agent": "bot"
        },
        "as": "bot"
      },
      {
        "call": "whoami",
        "on": "bot",
        "expect": {
          "result": {
            "user": null,
            "agent": "bot"
          }
        }
      }
    ]
  },
  {
