  {
    "id": "scope.a-star-agent-cannot-write-in-the-cloud",
    "transports": ["cloud"],
    "agents": {
      "cursor": {
        "star": true
      }
    },
    "seed": "basic",
    "options": {
      "agent": "cursor"
    },
    "steps": [
      {
        "call": "recall",
        "args": {
          "query": "billing deploy"
        },
        "expect": {
          "result": {
            "memories": {
              "$type": "array"
            }
          }
        }
      },
      {
        "call": "observe",
        "args": {
          "user": "a",
          "assistant": "b"
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "star-in-cloud"
          }
        }
      },
      {
        "call": "remember",
        "args": {
          "facts": ["x"]
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "star-in-cloud"
          }
        }
      },
      {
        "call": "forget",
        "args": {
          "id": "11111111-0000-4000-8000-000000000001"
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "star-in-cloud"
          }
        }
      },
      {
        "call": "pin",
        "args": {
          "id": "11111111-0000-4000-8000-000000000001"
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "star-in-cloud"
          }
        }
      }
    ]
  },
  {
    "id": "scope.whoami",
    "transports": ["local", "cloud"],
    "options": {
      "agent": "bot",
      "project": "acme-web"
    },
    "steps": [
      {
        "call": "whoami",
        "expect": {
          "result": {
            "mode": {
              "$regex": "^(local|cloud)$"
            },
            "agent": "bot",
            "project": "cfg:acme-web",
            "user": null,
            "reads": {
              "$type": "array"
            },
            "writesTo": "your Planet",
            "version": {
              "$type": "string"
            },
            "routes": {
              "embed": {
                "$type": "string"
              }
            }
          }
        }
      }
    ]
  }
