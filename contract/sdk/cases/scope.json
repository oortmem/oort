[
  {
    "id": "scope.two-users-of-one-agent-never-see-each-other",
    "transports": ["local"],
    "seed": "basic",
    "options": {
      "org": "acme"
    },
    "steps": [
      {
        "call": "scoped",
        "args": {
          "user": "u1",
          "agent": "bot"
        },
        "as": "u1"
      },
      {
        "call": "scoped",
        "args": {
          "user": "u2",
          "agent": "bot"
        },
        "as": "u2"
      },
      {
        "call": "remember",
        "on": "u1",
        "args": {
          "facts": ["The garden of u1 is in Kyoto."]
        },
        "save": {
          "kyoto": "$.results[0].id"
        }
      },
      {
        "call": "recall",
        "on": "u2",
        "args": {
          "query": "garden Kyoto"
        },
        "expect": {
          "result": {
            "memories": {
              "$none": {
                "text": {
                  "$regex": "Kyoto"
                }
              }
            }
          }
        }
      },
      {
        "call": "recall",
        "on": "u1",
        "args": {
          "query": "garden Kyoto"
        },
        "expect": {
          "result": {
            "memories": {
              "$some": {
                "id": "${kyoto}"
              }
            }
          }
        }
      },
      {
        "call": "recall",
        "on": "u2",
        "args": {
          "query": "dark mode editor"
        },
        "expect": {
          "result": {
            "memories": {
              "$none": {
                "id": "ffffffff-0000-4000-8000-000000000001"
              }
            }
          }
        }
      },
      {
        "call": "recall",
        "on": "u1",
        "args": {
          "query": "dark mode editor"
        },
        "expect": {
          "result": {
            "memories": {
              "$some": {
                "id": "ffffffff-0000-4000-8000-000000000001"
              }
            }
          }
        }
      },
      {
        "call": "recall",
        "on": "u1",
        "args": {
          "query": "internal escalation extension"
        },
        "expect": {
          "result": {
            "memories": {
              "$none": {
                "id": "dddddddd-0000-4000-8000-000000000003"
              }
            }
          }
        }
      },
      {
        "call": "recall",
        "on": "u1",
        "args": {
          "query": "anything",
          "include": ["star"]
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "scope-denied"
          }
        }
      },
      {
        "call": "explain",
        "on": "u2",
        "args": {
          "id": "${kyoto}"
        },
        "expect": {
          "error": {
            "code": "not-found"
          }
        }
      },
      {
        "call": "explain",
        "on": "u1",
        "args": {
          "id": "dddddddd-0000-4000-8000-000000000003"
        },
        "expect": {
          "error": {
            "code": "not-found"
          }
        }
      },
      {
        "call": "recent",
        "on": "u2",
        "expect": {
          "result": {
            "memories": [
              {
                "id": "ffffffff-0000-4000-8000-000000000002"
              }
            ]
          }
        }
      },
      {
        "call": "whoami",
        "on": "u1",
        "expect": {
          "result": {
            "user": "u1",
            "agent": "bot",
            "reads": ["Planet u1"],
            "writesTo": "Planet u1"
          }
        }
      }
    ]
  },
  {
