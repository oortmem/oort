      },
      {
        "call": "scoped",
        "args": {
          "project": "other"
        },
        "as": "other"
      },
      {
        "call": "recall",
        "on": "other",
        "args": {
          "query": "mobile app ships weekly"
        },
        "expect": {
          "result": {
            "memories": {
              "$some": {
                "id": "eeeeeeee-0000-4000-8000-000000000001"
