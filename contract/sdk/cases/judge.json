        "message": {
          "$regex": "dashboard"
        }
      }
    },
    "steps": []
  },
  {
    "id": "judge.cloud-a-key-records-and-a-person-decides",
    "description": "In Oort Cloud a key records for the account's listed experts, unconfirmed; confirm, withdraw and the experts list are a person's, in the dashboard (expert_only on the wire).",
    "transports": ["cloud"],
    "options": {
      "config": {
        "judge": {
          "experts": ["ada"]
        }
      }
    },
    "steps": [
      {
        "call": "judge.experts",
        "expect": {
          "result": {
            "experts": ["ada"]
          }
        }
      },
      {
        "call": "judge.record",
        "args": {
          "subject": "Post claims a cure",
          "verdict": "rejected",
          "reason": "No source.",
          "domain": "content",
          "by": "ada"
        },
        "expect": {
          "result": {
            "outcome": "added",
            "status": "agent-recorded"
          }
        },
        "save": {
          "j": "$.id"
        }
      },
      {
        "call": "judge.list",
        "expect": {
          "result": {
            "judgments": [
              {
                "id": "${j}",
                "via": "mcp",
                "agentRecorded": true,
                "confirmed": false,
                "origin": "agent"
              }
            ]
          }
        }
      },
      {
        "call": "judge.confirm",
        "args": {
          "id": "${j}"
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "expert-only",
            "status": 403
          }
        }
      },
      {
        "call": "judge.withdraw",
        "args": {
          "id": "${j}"
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "expert-only",
            "status": 403
          }
        }
      },
      {
        "call": "judge.setExperts",
        "args": {
          "experts": ["ada", "grace"]
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "expert-only",
            "status": 403
          }
        }
      },
      {
        "call": "judge.apply",
        "args": {
          "item": "Post claims a cure"
        },
        "expect": {
          "result": {
            "agentRecordedExcluded": 1,
            "predictionId": {
              "$absent": true
            }
          }
        }
      }
    ]
  },
  {
    "id": "judge.resolve-closes-a-kept-prediction",
    "transports": ["local"],
    "seed": "judgments",
    "options": {
      "judge": {
        "role": "expert",
        "operator": "marcus"
      }
    },
    "steps": [
      {
        "call": "judge.apply",
        "args": {
          "item": {
            "summary": "Post claims a miracle cure for cancer, says a blog",
            "domain": "content"
          }
        },
        "expect": {
          "result": {
            "predictionId": {
              "$type": "string"
            }
          }
        },
        "save": {
          "prediction": "$.predictionId"
        }
      },
      {
        "call": "judge.listPredictions",
        "args": {},
        "expect": {
          "result": {
            "predictions": {
              "$some": {
                "id": "${prediction}",
                "state": "pending",
                "verdicts": ["approved", "rejected"]
              }
            }
          }
        }
      },
      {
        "call": "judge.resolve",
        "args": {
          "id": "${prediction}",
          "verdict": "approved",
          "reason": "Satire account, labelled as parody.",
          "by": "ada"
        },
        "expect": {
          "result": {
            "prediction": {
              "id": "${prediction}",
              "state": "resolved",
              "resolution": {
                "verdict": "approved",
                "reason": "Satire account, labelled as parody.",
                "by": "ada",
                "via": "sdk",
                "agentRecorded": false
              }
            },
            "judgment": {
              "outcome": "added",
              "status": "recorded"
            }
          }
        },
        "save": {
          "judgment": "$.judgment.id"
        }
      },
      {
        "call": "judge.list",
        "args": {},
        "expect": {
          "result": {
            "judgments": {
              "$some": {
                "id": "${judgment}",
                "verdict": "approved",
                "reason": "Satire account, labelled as parody."
              }
            }
          }
        }
      },
      {
        "call": "judge.resolve",
        "args": {
          "id": "${prediction}",
          "verdict": "rejected",
          "by": "ada"
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "already-resolved"
          }
        }
      },
      {
        "call": "judge.evalLive",
        "args": {},
        "expect": {
          "result": {
            "resolved": 1,
            "pending": 0,
            "agentResolvedExcluded": 0,
            "bands": {
              "$len": 6
            }
          }
        }
      },
      {
        "call": "judge.forgetPrediction",
        "args": {
          "id": "${prediction}"
        },
        "expect": {
          "result": {
            "id": "${prediction}",
            "forgotten": true
          }
        }
      },
      {
        "call": "judge.getPrediction",
        "args": {
          "id": "${prediction}"
        },
        "expect": {
          "error": {
            "code": "not-found"
          }
        }
      }
    ]
  },
