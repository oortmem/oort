[
  {
    "id": "judge.agent-record-is-unconfirmed",
    "transports": ["local"],
    "seed": "empty",
    "options": {
      "agent": "bot",
      "config": {
        "judge": {
          "experts": ["ada"]
        }
      }
    },
    "now": "2026-11-05T12:00:00Z",
    "steps": [
      {
        "call": "judge.record",
        "args": {
          "subject": "Post claims a cure",
          "verdict": "rejected",
          "reason": "No source.",
          "domain": "content",
          "by": "ada"
        },
        "expect": {
          "result": {
            "outcome": "added",
            "id": {
              "$type": "string"
            },
            "status": "agent-recorded",
            "redacted": []
          }
        },
        "save": {
          "judgment": "$.id"
        }
      },
      {
        "call": "judge.list",
        "args": {},
        "expect": {
          "result": {
            "judgments": {
              "$some": {
                "id": "${judgment}",
                "via": "mcp",
                "agentRecorded": true,
                "confirmed": false
              }
            }
          }
        }
      },
      {
        "call": "reader.judgment",
        "args": {
          "id": "${judgment}"
        },
        "expect": {
          "result": {
            "found": true,
            "via": "mcp",
            "harness": "sdk",
            "unconfirmedAgent": true
          }
        }
      },
      {
        "call": "judge.confirm",
        "args": {
          "id": "${judgment}"
        },
        "expect": {
          "error": {
            "code": "refused",
            "reason": "expert-only"
          }
        }
      }
    ]
  },
