  {
    "id": "judge.apply-leaves-out-unconfirmed-agent-records",
    "transports": ["local", "cloud"],
    "seed": "judgments",
    "steps": [
      {
        "call": "judge.apply",
        "args": {
          "item": {
            "summary": "Post claims a miracle cure for cancer",
            "domain": "content"
          }
        },
        "expect": {
          "result": {
            "status": {
              "$regex": "^(suggested|needs-expert|precedents-only)$"
            },
            "precedents": {
              "$every": {
                "agentRecorded": false,
                "by": "ada"
              }
            },
            "agentRecordedExcluded": 1,
            "decisions": {
              "$type": "array"
            }
          }
        }
      },
      {
        "call": "judge.apply",
        "args": {
          "item": {
            "summary": "Post claims a miracle cure for cancer",
            "domain": "content"
          },
          "includeAgentRecorded": true,
          "limit": 10
        },
        "expect": {
          "result": {
            "agentRecordedExcluded": {
              "$absent": true
            },
            "precedents": {
              "$some": {
                "agentRecorded": true
              }
            }
          }
        }
      },
      {
        "call": "judge.list",
        "args": {
          "all": true,
          "limit": 2
        },
        "expect": {
          "result": {
            "judgments": {
              "$len": 2
            }
          }
        }
      }
    ]
  },
